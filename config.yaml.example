# Copy this to /config/config.yaml (the appdata path you map to /config
# in the Unraid template) and adjust as needed. BEETSDIR=/config is baked
# into the image, so beets will look for config.yaml and library.db here
# by default.

directory: /music/library
library: /config/library.db

per_disc_numbering: yes
artist_credit: yes
# Without this, artist/albumartist (and the plural artists/albumartists)
# use MusicBrainz's raw artist-entity name, not the release's own credit
# -- for a translated/transliterated pseudo-release specifically chosen
# to get e.g. "Yoko Shimomura" instead of "下村陽子", the entity name
# stays in its native script regardless, since only the release CREDIT
# was translated. This makes those fields follow the credit instead.

import:
    move: no
    copy: yes
    write: yes
    log: /config/import.log
    timid: yes
    # move: no / copy: yes duplicates files from /music/incoming into
    # /music/library instead of relocating them. Since both are on the
    # same Unraid array (no network hop like the sandbox setup had), you
    # may prefer move: yes / copy: no once you trust the pipeline, to
    # avoid holding two copies of everything.
    duplicate_keys:
        album: albumartist album albumdisambig
    # Default duplicate_keys is just "albumartist album" -- MusicBrainz's
    # canonical title for every self-titled Weezer "color" album (Blue,
    # Green, Red, Black, Teal, White, Gold) is literally just "Weezer",
    # disambiguated only via albumdisambig. Without this, the second such
    # album imported in a batch always looks like a duplicate of the
    # first, even though they're different records. A genuine re-import
    # of the same album still gets caught correctly with this added.

paths:
    default: $formatcode/$channels-Channel/%if{$is_soundtrack,Soundtracks,%upper{%left{$albumartist,1}}/$albumartist}/($original_year) $album%if{$distinctdisambig, ($distinctdisambig)} {$albumtype_display} [%first{$media,1,0, (}]%aunique{}/$discprefix$track $title
    singleton: Non-Album/$artist/$title
    comp: $formatcode/$channels-Channel/Compilations/($original_year) $album%if{$distinctdisambig, ($distinctdisambig)} {$albumtype_display} [%first{$media,1,0, (}]%aunique{}/$discprefix$track $artist - $title

plugins:
    - musicbrainz
    - originquery
    - scrub
    - roon_artwork
    - replaygain
    - classical_tags

replaygain:
    backend: metaflac

musicbrainz:
    extra_tags: [year, catalognum, country, media, label, albumdisambig]

roon_artwork:
    fetch_caa_art: no

originquery:
    origin_file: origin.yaml
    tag_patterns:
        album: '$.Name'
        artist: '$.Artist'
        media: '$.Media'
        year: '$.["Edition year"]'
        label: '$.["Record label"]'
        catalognum: '$.["Catalog number"]'
        albumdisambig: '$.Edition'
        genres: '$.Tags'
